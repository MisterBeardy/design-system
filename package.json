{
  "name": "@misterbeardy/design-system",
  "version": "1.1.0",
  "description": "Shared design system for the MisterBeardy app portfolio — tokens, core components, accent registry.",
  "type": "module",
  "types": "./components/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./components/core/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./tokens/colors.css": "./tokens/colors.css",
    "./tokens/fonts.css": "./tokens/fonts.css",
    "./tokens/typography.css": "./tokens/typography.css",
    "./tokens/spacing.css": "./tokens/spacing.css",
    "./tokens/motion.css": "./tokens/motion.css",
    "./tokens/materials.css": "./tokens/materials.css",
    "./core.css": "./components/core/core.css",
    "./icons/*": "./icons/*",
    "./app-registry": "./app-registry.js"
  },
  "files": [
    "dist",
    "ADOPTING.md",
    "UPGRADING-1.0.md",
    "CHANGELOG.md",
    "components",
    "icons",
    "guidelines",
    "tokens",
    "styles.css",
    "app-registry.js",
    "readme.md",
    "SKILL.md"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "license": "UNLICENSED",
  "private": false,
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node scripts/check-tokens.mjs && node scripts/check-changelog.mjs"
  }
}
